# VBF Elektromos Rajzkészítő - Környezeti Változók
# Másold ezt a fájlt: .env néven és töltsd ki az értékeket

# JWT aláíráshoz (auth.py: SECRET_KEY) — élesben erős, véletlenszerű string; ne commitold a valódi értéket.
SECRET_KEY=change-me-in-production-use-long-random-string

# Környezet és CORS (ENV=production esetén kötelező: SECRET_KEY, CORS_ORIGINS)
ENV=development
# Példa production-re:
# CORS_ORIGINS=https://vbfpremium.hu,https://www.vbfpremium.hu
CORS_ORIGINS=

# Stripe fizetési integráció
# Bankkártyás fizetés kapcsoló (0 = kikapcsolva, 1 = bekapcsolva)
CARD_PAYMENTS_ENABLED=0
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# SMTP email küldés (opcionális)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
