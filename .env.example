# VBF Elektromos Rajzkészítő - Környezeti Változók
# Másold ezt a fájlt: .env néven és töltsd ki az értékeket

# JWT titkos kulcs (változtasd meg production-ban!)
JWT_SECRET=super-secret-jwt-key-change-in-production

# Stripe fizetési integráció
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# SMTP email küldés (opcionális)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Postgres + Redis (SaaS: docker-compose.postgres.yml) ---
# Ha DATABASE_URL nincs beállítva, SQLite fut (./data/vbf_database.db).
# DATABASE_URL=postgresql://user:password@host:5432/dbname
POSTGRES_USER=vbf
POSTGRES_PASSWORD=vbf_secret_change_me
POSTGRES_DB=vbf

# Redis (rate limit, bejelentkezési lock)
REDIS_HOST=redis
REDIS_PORT=6379
