# VBF Elektromos Rajzkészítő - Környezeti Változók
# Másold ezt a fájlt: .env néven és töltsd ki az értékeket

# JWT titkos kulcs (változtasd meg production-ban!)
JWT_SECRET=super-secret-jwt-key-change-in-production

# Környezet és CORS (production-ben kötelező)
ENV=development
# Példa production-re:
# CORS_ORIGINS=https://vbfpremium.hu,https://www.vbfpremium.hu
CORS_ORIGINS=

# Stripe fizetési integráció
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# SMTP email küldés (opcionális)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
